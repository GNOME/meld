"              (\"Барлық бос орындар\", false, \"[ \\\\t\\\\r\\\\f\\\\v]*\"),\n"
"              (\"Алдыңғы бос орындар\", false, \"^[ \\\\t\\\\r\\\\f\\\\v]*\"),\n"
